rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function validUser() {
      return request.resource.data.keys().hasOnly(['email','displayName','ageBand','avatar','termsVersion','privacyVersion','emailVerified','createdAt','updatedAt'])
        && request.resource.data.ageBand in ['16-17','18+'];
    }

    match /users/{uid} {
      allow read, delete: if owns(uid);
      allow create, update: if owns(uid) && validUser();

      match /settings/{document=**} { allow read, write: if owns(uid); }
      match /moodEntries/{entryId} {
        allow read, delete: if owns(uid);
        allow create, update: if owns(uid)
          && request.resource.data.mood is int
          && request.resource.data.mood >= 1
          && request.resource.data.mood <= 5;
      }
      match /habits/{habitId} { allow read, write: if owns(uid); }
      match /habitLogs/{logId} { allow read, write: if owns(uid); }
      match /healthDaily/{date} { allow read, write: if owns(uid); }
      match /chatSessions/{sessionId} {
        allow read, delete: if owns(uid);
        allow create, update: if false;
        match /messages/{messageId} { allow read, delete: if owns(uid); allow create, update: if false; }
      }
    }

    match /content/{contentId} { allow read: if resource.data.published == true; allow write: if false; }
    match /crisisResources/{resourceId} { allow read: if true; allow write: if false; }
    match /privateRateLimits/{uid} { allow read, write: if false; }
  }
}
