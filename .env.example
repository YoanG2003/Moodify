# Public Firebase client configuration (safe to embed; protect data with Rules and App Check)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_FUNCTIONS_REGION=europe-west1
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# EAS file-secret paths. When both are present, the native Firebase plugins,
# App Check, Crashlytics, and Analytics are included in the native build.
GOOGLE_SERVICES_PLIST=
GOOGLE_SERVICES_JSON=

# Configure on Firebase Functions with: firebase functions:secrets:set OPENAI_API_KEY
# OPENAI_CHAT_MODEL is a server environment setting. The default is gpt-5-mini.
